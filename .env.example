# Option A: OpenRouter (default, free models are rate limited)
OPENROUTER_API_KEY=
# Optional backup free model; the primary model is always openrouter/free
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free

# Option B: Gemini (takes priority when GEMINI_API_KEY is set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
