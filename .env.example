# Recommended: one OpenRouter API key (keep it in Vercel, never in GitHub)
OPENROUTER_API_KEY=
# Defaults to openrouter/free if omitted. Paid models are blocked.
OPENROUTER_MODEL=openrouter/free

# Optional legacy Gemini alternative only when OpenRouter is not configured.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
