# Option A: OpenRouter (used when Gemini is not configured; free models are rate limited)
OPENROUTER_API_KEY=
# Optional backup free model (primary: google/gemma-4-26b-a4b-it:free)
OPENROUTER_MODEL=openrouter/free

# Option B: Gemini (preferred when GEMINI_API_KEY is set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
